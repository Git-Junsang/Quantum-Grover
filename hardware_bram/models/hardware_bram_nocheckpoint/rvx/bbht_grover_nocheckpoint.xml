<?xml version="1.0" ?>
<rvx>
    <platform>
        <name>bbht_grover_nocheckpoint</name>
        <status>described</status>

        <!-- hardware_bram_nocheckpoint: 체크포인트 없이 연산기 네 벌(E4)만 켠 판.
             SoC 구성(IP 셋, 클럭, SRAM)은 bbht_grover_upgrade 와 한 글자도 다르지
             않고, 다른 것은 user region 에 들어가는 어댑터의 파라미터뿐입니다.
             같은 조건에서 최적화 유무만 바꿔 속도를 맞대려는 것이라 일부러 같게
             두었습니다. -->

        <!-- Dedicated BBHT/Grover accelerator clock -->
        <clock_info>
            <define>
                <name>clk_accel</name>
                <value type="dec">100000000</value>
            </define>
        </clock_info>

        <spec>
            <!-- Q14 최대 dataset 32 KiB + firmware/stack 여유를 포함한 baseline -->
            <define>
                <name>sram_size</name>
                <value>128kB</value>
            </define>
        </spec>

        <!-- RISC-V main core -->
        <ip_instance>
            <name>i_main_core</name>
            <library_name>rvc_orca</library_name>
        </ip_instance>

        <!-- BBHT/Grover control/status CSR: APB slave -->
        <ip_instance>
            <name>i_grover_csr</name>
            <library_name>user_slaveif_apb_clkout</library_name>

            <parameter>
                <id>SIZE_OF_MEMORYMAP</id>
                <value>0x1000</value>
            </parameter>

            <parameter>
                <id>BW_ADDR</id>
                <value>32</value>
            </parameter>

            <parameter>
                <id>BW_DATA</id>
                <value>32</value>
            </parameter>
        </ip_instance>

        <!-- Dataset loader: AHB master -->
        <ip_instance>
            <name>i_grover_dma</name>
            <library_name>user_masterif_ahb_clkout</library_name>

            <parameter>
                <id>BW_ADDR</id>
                <value>32</value>
            </parameter>

            <parameter>
                <id>BW_DATA</id>
                <value>32</value>
            </parameter>
        </ip_instance>

    </platform>
</rvx>
