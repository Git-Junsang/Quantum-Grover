<?xml version="1.0" ?>
<rvx>
    <platform>
        <name>bbht_grover_upgrade</name>
        <status>described</status>

        <!-- Dedicated BBHT/Grover accelerator clock -->
        <clock_info>
            <define>
                <name>clk_accel</name>
                <value type="dec">100000000</value>
            </define>
        </clock_info>

        <spec>
            <!-- Q14 최대 dataset 32 KiB + firmware/stack 여유를 포함한 baseline -->
            <define>
                <name>sram_size</name>
                <value>128kB</value>
            </define>
        </spec>

        <!-- RISC-V main core -->
        <ip_instance>
            <name>i_main_core</name>
            <library_name>rvc_orca</library_name>
        </ip_instance>

        <!-- BBHT/Grover control/status CSR: APB slave -->
        <ip_instance>
            <name>i_grover_csr</name>
            <library_name>user_slaveif_apb_clkout</library_name>

            <parameter>
                <id>SIZE_OF_MEMORYMAP</id>
                <value>0x1000</value>
            </parameter>

            <parameter>
                <id>BW_ADDR</id>
                <value>32</value>
            </parameter>

            <parameter>
                <id>BW_DATA</id>
                <value>32</value>
            </parameter>
        </ip_instance>

        <!-- Dataset loader: AHB master -->
        <ip_instance>
            <name>i_grover_dma</name>
            <library_name>user_masterif_ahb_clkout</library_name>

            <parameter>
                <id>BW_ADDR</id>
                <value>32</value>
            </parameter>

            <parameter>
                <id>BW_DATA</id>
                <value>32</value>
            </parameter>
        </ip_instance>

    </platform>
</rvx>
