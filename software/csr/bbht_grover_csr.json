{
  "_comment": [
    "BBHT/Grover CSR 정본 (single source of truth).",
    "출처: PJK 'LPSoC_BBHT_Grover_팀원_Handoff_SW_통신_v0.9.8반영_2026-09-01' §1.4 / §1.5.",
    "이 파일을 고치면 gen_csr.py 를 다시 돌려 generated/ 를 갱신하십시오.",
    "C 헤더와 Verilog 헤더를 손으로 고치지 마십시오 - 두 곳이 어긋나는 것이 이 정본을 만든 이유입니다."
  ],

  "name": "bbht_grover",
  "version": "0.9.8",
  "date": "2026-09-01",

  "base_macro": "I_GROVER_CSR_SLAVE_BASEADDR",
  "base_value": "0xE2020000",
  "memorymap_size": "0x1000",
  "stride": 4,
  "data_width": 32,

  "_base_note": [
    "base_value 는 로컬 RVX 생성물(arch/ssw/src/memorymap_info.h)에서 실측한 값입니다.",
    "C 코드는 이 숫자를 박지 말고 base_macro 를 쓰십시오 - 플랫폼 XML 이 바뀌면 주소가 옮겨갑니다."
  ],

  "search_space": {
    "q_bits": 14,
    "n_entries": 16384,
    "data_word_bits": 16,
    "data_signed": true,
    "result_index_bits": 14,
    "result_fifo_depth": 256,
    "accel_clk_hz": 100000000,
    "system_clk_hz": 50000000,
    "sram_base": "0xE0000000",
    "sram_last": "0xE001FFFF"
  },

  "registers": [
    { "offset": "0x000", "name": "COMMAND", "access": "W1P", "width": 1,
      "desc": "탐색 시작. 쓰는 행위 자체가 명령이고 저장 공간이 없습니다",
      "fields": [ { "name": "search_start", "bits": "0", "desc": "external search start" } ] },

    { "offset": "0x004", "name": "CONTROL", "access": "RW", "width": 4,
      "desc": "동작 모드",
      "fields": [
        { "name": "auto_shot",      "bits": "0",   "desc": "1: BBHT 가 requested j 자동 생성" },
        { "name": "burst_enable",   "bits": "1",   "desc": "1: checkpoint 재사용 사용 (K·H 는 RTL 빌드 상수. 현 freeze 는 K3/H3)" },
        { "name": "predicate_mode", "bits": "3:2", "desc": "00 LT / 01 GT / 10 EQ / 11 RANGE" }
      ] },

    { "offset": "0x008", "name": "J_TARGET", "access": "RW", "width": 7,
      "desc": "manual requested j (0~127). auto_shot=1 이면 무시됩니다" },

    { "offset": "0x00C", "name": "THRESHOLD_A", "access": "RW", "width": 16, "signed": true,
      "desc": "임계값 A. RANGE 에서는 하한" },

    { "offset": "0x010", "name": "THRESHOLD_B", "access": "RW", "width": 16, "signed": true,
      "desc": "임계값 B. RANGE 상한 (A < data < B, 열린구간)" },

    { "offset": "0x014", "name": "DATA_COUNT", "access": "RW", "width": 15,
      "desc": "유효 데이터 개수 1~16384. 그 이후 인덱스는 non-target" },

    { "offset": "0x018", "name": "SHOT_CAP", "access": "RW", "width": 16,
      "desc": "BBHT shot 상한. 기본 100" },

    { "offset": "0x01C", "name": "SEED_J", "access": "RW", "width": 32,
      "desc": "requested-j PRNG 시드" },

    { "offset": "0x020", "name": "SEED_MEAS", "access": "RW", "width": 32,
      "desc": "측정 PRNG 시드. SEED_J 와 독립" },

    { "offset": "0x024", "name": "STATUS", "access": "RO", "width": 12,
      "desc": "실행 상태. bit 정의는 status_bits 참조" },

    { "offset": "0x028", "name": "RESULT_INDEX", "access": "RO", "width": 14,
      "desc": "Single 모드 결과 인덱스. STATUS.result_valid 가 1 일 때만 의미가 있습니다" },

    { "offset": "0x02C", "name": "TRIAL_COUNT", "access": "RO", "width": 32,
      "desc": "run 전체의 logical trial 수" },

    { "offset": "0x030", "name": "L_BBHT", "access": "RO", "width": 32,
      "desc": "Sum of requested j - 알고리즘 지표. checkpoint 로 줄지 않습니다" },

    { "offset": "0x034", "name": "ACTUAL_ITER", "access": "RO", "width": 32,
      "desc": "실제로 돌린 물리 Grover 반복 수 - checkpoint 가 줄이는 대상" },

    { "offset": "0x038", "name": "CYCLE_COUNT", "access": "RO", "width": 32,
      "desc": "run 소비 사이클. clk_accel(100 MHz) 기준이므로 us = cycles/100" },

    { "offset": "0x03C", "name": "ENUM_CFG", "access": "RW", "width": 8,
      "desc": "열거 모드 설정",
      "fields": [
        { "name": "enum_enable",       "bits": "0",   "desc": "0: Single, 1: Enumeration" },
        { "name": "fail_repeat_limit", "bits": "7:4", "desc": "complete-BBHT failure 반복 한계. 유효 1~15, 0 은 config error" }
      ] },

    { "offset": "0x040", "name": "FIFO_DATA", "access": "RPOP", "width": 14,
      "desc": "Result FIFO head. 읽기 완료 자체가 pop 입니다. 별도 POP 레지스터는 없습니다" },

    { "offset": "0x044", "name": "FIFO_COUNT", "access": "RO", "width": 9,
      "desc": "현재 FIFO occupancy" },

    { "offset": "0x048", "name": "FOUND_COUNT", "access": "RO", "width": 15,
      "desc": "unique target 누적" },

    { "offset": "0x04C", "name": "CONSEC_FAIL", "access": "RO", "width": 4,
      "desc": "complete BBHT failure 연속 횟수" },

    { "offset": "0x050", "name": "MAX_FIFO_OCC", "access": "RO", "width": 9,
      "desc": "run 중 최대 occupancy" },

    { "offset": "0x054", "name": "FIFO_STALL", "access": "RO", "width": 32,
      "desc": "FIFO full 로 멈춘 사이클" },

    { "offset": "0x058", "name": "DATA_ADDR", "access": "RW", "width": 32,
      "desc": "System SRAM 원본 주소. 4바이트 정렬 필수" },

    { "offset": "0x05C", "name": "DMA_COMMAND", "access": "W1P", "width": 1,
      "desc": "DMA 적재 시작",
      "fields": [ { "name": "dma_start", "bits": "0", "desc": "DMA session start" } ] },

    { "offset": "0x060", "name": "DMA_STATUS", "access": "RO", "width": 8,
      "desc": "DMA 상태. bit 정의는 dma_status_bits 참조" },

    { "offset": "0x064", "name": "POLICY_CYCLES_TOTAL",      "access": "RO", "width": 32, "desc": "policy 총 사이클",   "group": "telemetry" },
    { "offset": "0x068", "name": "POLICY_STALL_CYCLES",      "access": "RO", "width": 32, "desc": "policy stall",        "group": "telemetry" },
    { "offset": "0x06C", "name": "POLICY_ACTIONS_EVAL",      "access": "RO", "width": 32, "desc": "평가한 action 수",    "group": "telemetry" },
    { "offset": "0x070", "name": "POLICY_MEMO_HIT",          "access": "RO", "width": 32, "desc": "memo hit",            "group": "telemetry" },
    { "offset": "0x074", "name": "POLICY_MEMO_MISS",         "access": "RO", "width": 32, "desc": "memo miss",           "group": "telemetry" },
    { "offset": "0x078", "name": "POLICY_MAX_LATENCY",       "access": "RO", "width": 32, "desc": "policy 최대 지연",     "group": "telemetry" },
    { "offset": "0x07C", "name": "PLAN_FIFO_LEVEL",          "access": "RO", "width": 3,  "desc": "현재 plan FIFO 레벨",  "group": "telemetry" },
    { "offset": "0x080", "name": "PLAN_FIFO_HIGHWATER",      "access": "RO", "width": 3,  "desc": "plan FIFO 최고 수위",  "group": "telemetry" },
    { "offset": "0x084", "name": "PLAN_FIFO_EMPTY_DEMAND",   "access": "RO", "width": 32, "desc": "demand 시 empty 횟수", "group": "telemetry" },
    { "offset": "0x088", "name": "PLAN_FIFO_HIT_COUNT",      "access": "RO", "width": 32, "desc": "speculative plan hit", "group": "telemetry" },
    { "offset": "0x08C", "name": "PLAN_FIFO_MISMATCH_COUNT", "access": "RO", "width": 32, "desc": "정상 기대값 0",        "group": "telemetry" },
    { "offset": "0x090", "name": "POLICY_COLD_SOLVE_COUNT",  "access": "RO", "width": 32, "desc": "cold solve 횟수",      "group": "telemetry" },
    { "offset": "0x094", "name": "POLICY_SPEC_SOLVE_COUNT",  "access": "RO", "width": 32, "desc": "speculative solve",    "group": "telemetry" }
  ],

  "status_bits": [
    { "bit": 0,  "name": "busy",              "desc": "search/main busy" },
    { "bit": 1,  "name": "load_busy",         "desc": "Main IP loader busy" },
    { "bit": 2,  "name": "done_sticky",       "desc": "search 완료 sticky. COMMAND 쓰기로 클리어" },
    { "bit": 3,  "name": "result_valid",      "desc": "Single result 유효" },
    { "bit": 4,  "name": "config_error",      "desc": "설정 오류 sticky" },
    { "bit": 5,  "name": "shot_limit",        "desc": "shot cap 도달 sticky" },
    { "bit": 6,  "name": "budget_limit",      "desc": "BBHT logical budget 도달 sticky" },
    { "bit": 7,  "name": "amp_overflow",      "desc": "진폭 포화 sticky. 진단용이며 종료 사유가 아님" },
    { "bit": 8,  "name": "zero_weight_error", "desc": "Born total-weight 오류 sticky" },
    { "bit": 9,  "name": "load_error",        "desc": "loader 검증 오류 sticky" },
    { "bit": 10, "name": "enum_done",         "desc": "Enumeration 종료 sticky" },
    { "bit": 11, "name": "fifo_empty",        "desc": "Result FIFO 비어 있음" }
  ],

  "dma_status_bits": [
    { "bit": 0, "name": "dma_busy",        "desc": "DMA 진행 중" },
    { "bit": 1, "name": "dma_error",       "desc": "아래 오류들의 OR" },
    { "bit": 2, "name": "align_error",     "desc": "DATA_ADDR 4바이트 정렬 위반" },
    { "bit": 3, "name": "count_error",     "desc": "DATA_COUNT 범위 위반" },
    { "bit": 4, "name": "resp_error",      "desc": "AHB 응답 오류" },
    { "bit": 5, "name": "busy_error",      "desc": "Main IP busy 라서 DMA 거절" },
    { "bit": 6, "name": "range_error",     "desc": "System SRAM 범위 밖" },
    { "bit": 7, "name": "dma_done_sticky", "desc": "DMA 완료 sticky" }
  ],

  "predicate_modes": [
    { "value": 0, "name": "LT",    "desc": "data < A" },
    { "value": 1, "name": "GT",    "desc": "data > A" },
    { "value": 2, "name": "EQ",    "desc": "data == A" },
    { "value": 3, "name": "RANGE", "desc": "A < data < B (열린구간)" }
  ],

  "run_modes": [
    { "name": "MANUAL_SINGLE",  "auto_shot": 0, "burst_enable": 0, "enum_enable": 0, "desc": "J_TARGET 을 펌웨어가 지정" },
    { "name": "NORMAL_SINGLE",  "auto_shot": 1, "burst_enable": 0, "enum_enable": 0, "desc": "표준 BBHT" },
    { "name": "K4H8_SINGLE",    "auto_shot": 1, "burst_enable": 1, "enum_enable": 0, "desc": "checkpoint 모드 (K·H·E·M 은 RTL 빌드에 컴파일됨. 현 정본은 K3/H3-E4-M2. 이름의 K4H8 은 옛 표기)" },
    { "name": "NORMAL_ENUM",    "auto_shot": 1, "burst_enable": 0, "enum_enable": 1, "desc": "표준 BBHT 열거" },
    { "name": "K4H8_ENUM",      "auto_shot": 1, "burst_enable": 1, "enum_enable": 1, "desc": "checkpoint 열거 (K·H·E·M 은 RTL 빌드에 컴파일됨. 현 정본은 K3/H3-E4-M2. 이름의 K4H8 은 옛 표기)" }
  ]
}
