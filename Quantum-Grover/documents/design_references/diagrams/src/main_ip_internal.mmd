flowchart TD
    TOP["bbht_grover_main_ip<br/>CKPT_K=3 POLICY_H_FUTURE=3<br/>INTRA_ENGINES=4 MEAS_M1/M2=1"]

    TOP --> LD["grover_loader_ctrl<br/>dataset load · 중복 address 검출"]
    TOP --> SHOT["grover_bbht_shot_fsm<br/>Shot Controller"]
    TOP --> POL["grover_ckpt_policy_rolling<br/>3-shot Lookahead DP Policy Engine"]
    TOP --> EXE["grover_ckpt_executor<br/>segment 실행 · 경계 commit"]
    TOP --> ITER["grover_ctrl_fsm_ckpt_e4<br/>Iteration Datapath FSM"]
    TOP --> MEAS["grover_measure_verify<br/>Born-rule sampling + solution check"]
    TOP --> ST["grover_status_counters<br/>sticky state · counter"]

    SHOT --> RNG["grover_lfsr32_jump7<br/>grover_j_reject · grover_iter_rom"]
    SHOT --> CACHE["grover_cache_ctrl<br/>Single-Slot Checkpoint 재사용 판단"]

    POL --> MEMO["grover_ckpt_policy_memo<br/>memo table · 2,048 × 18 bank · 3-shot Lookahead × 1,093 ranks"]
    POL --> SHJ["grover_shadow_j<br/>Iteration-Count Predictor"]
    POL --> PFIFO["grover_ckpt_plan_fifo<br/>Plan Queue"]
    POL --> PLAN["grover_ckpt_planner_pipe<br/>request 집합을 checkpoint slot 계획으로"]
    PLAN --> EXE

    EXE --> ITER
    ITER --> DP["grover_iter_datapath_e4<br/>Pass 1 / Mean / Pass 2"]
    DP --> ARI["grover_predicate · grover_oracle_flip<br/>grover_adder_tree · grover_diffusion_sat"]

    ITER --> AMP["grover_amp_mem_packed<br/>512 rows × 32 lanes × 23 bits"]
    EXE --> CK["grover_ckpt_mem_interleaved_e4<br/>checkpoint slot 3벌"]
    ITER --> DATA["grover_data_mem_e4<br/>dataset 16,384칸"]

    MEAS --> SQ["grover_born_square32<br/>32 lanes square + adder tree"]
    MEAS --> RW["grover_row_weight_mem_m1_2w<br/>row weight · 16 × 32 group prefix sum"]
    MEAS --> VF["grover_verify<br/>predicate 재검사 + Found Mask"]
    MEAS --> FIFO["grover_result_fifo<br/>깊이 256"]
    AMP --> SQ
