{
  "_comment": [
    "BBHT/Grover CSR source of truth.",
    "출처: PJK 'LPSoC_BBHT_Grover_팀원_Handoff_SW_통신_v0.9.8반영_2026-09-01' §1.4 / §1.5.",
    "이 file을 고치면 gen_csr.py 를 다시 돌려 generated/ 를 갱신하십시오.",
    "C header와 Verilog header를 손으로 고치지 마십시오 - 두 곳이 어긋나는 것이 이 source of truth를 만든 이유입니다."
  ],

  "name": "bbht_grover",
  "version": "0.9.8",
  "date": "2026-09-01",

  "base_macro": "I_GROVER_CSR_SLAVE_BASEADDR",
  "base_value": "0xE2020000",
  "memorymap_size": "0x1000",
  "stride": 4,
  "data_width": 32,

  "_base_note": [
    "base_value 는 로컬 RVX 생성물(arch/ssw/src/memorymap_info.h)에서 실측한 값입니다.",
    "C code는 이 숫자를 박지 말고 base_macro 를 쓰십시오 - platform XML 이 바뀌면 address가 옮겨갑니다."
  ],

  "search_space": {
    "q_bits": 14,
    "n_entries": 16384,
    "data_word_bits": 16,
    "data_signed": true,
    "result_index_bits": 14,
    "result_fifo_depth": 256,
    "accel_clk_hz": 100000000,
    "system_clk_hz": 50000000,
    "sram_base": "0xE0000000",
    "sram_last": "0xE001FFFF"
  },

  "registers": [
    { "offset": "0x000", "name": "COMMAND", "access": "W1P", "width": 1,
      "desc": "search 시작. 쓰는 행위 자체가 명령이고 저장 공간이 없습니다",
      "fields": [ { "name": "search_start", "bits": "0", "desc": "external search start" } ] },

    { "offset": "0x004", "name": "CONTROL", "access": "RW", "width": 4,
      "desc": "동작 mode",
      "fields": [
        { "name": "auto_shot",      "bits": "0",   "desc": "1: BBHT가 requested iterations를 자동 생성" },
        { "name": "burst_enable",   "bits": "1",   "desc": "1: checkpoint 재사용 사용 (Checkpoint-Capacity · Lookahead-Shots는 RTL build constant. 현 freeze는 a Checkpoint-Capacity of 3 and 3-shot Lookahead)" },
        { "name": "predicate_mode", "bits": "3:2", "desc": "00 LT / 01 GT / 10 EQ / 11 RANGE" }
      ] },

    { "offset": "0x008", "name": "J_TARGET", "access": "RW", "width": 7,
      "desc": "Manual mode의 requested iterations (0~127). auto_shot=1이면 무시됩니다" },

    { "offset": "0x00C", "name": "THRESHOLD_A", "access": "RW", "width": 16, "signed": true,
      "desc": "threshold A. RANGE 에서는 lower bound" },

    { "offset": "0x010", "name": "THRESHOLD_B", "access": "RW", "width": 16, "signed": true,
      "desc": "threshold B. RANGE 상한 (A < data < B, 열린구간)" },

    { "offset": "0x014", "name": "DATA_COUNT", "access": "RW", "width": 15,
      "desc": "유효 data 개수 1~16384. 그 이후 index는 non-solution" },

    { "offset": "0x018", "name": "SHOT_CAP", "access": "RW", "width": 16,
      "desc": "BBHT shot cap. 기본 100" },

    { "offset": "0x01C", "name": "SEED_J", "access": "RW", "width": 32,
      "desc": "Iteration-Count LFSR seed" },

    { "offset": "0x020", "name": "SEED_MEAS", "access": "RW", "width": 32,
      "desc": "Measurement PRNG seed. SEED_J 와 독립" },

    { "offset": "0x024", "name": "STATUS", "access": "RO", "width": 12,
      "desc": "실행 state. bit 정의는 status_bits 참조" },

    { "offset": "0x028", "name": "RESULT_INDEX", "access": "RO", "width": 14,
      "desc": "Single mode 결과 index. STATUS.result_valid 가 1 일 때만 의미가 있습니다" },

    { "offset": "0x02C", "name": "SHOT_COUNT", "access": "RO", "width": 32,
      "desc": "run 전체의 shot 수" },

    { "offset": "0x030", "name": "REQUESTED_ITERATIONS", "access": "RO", "width": 32,
      "desc": "requested iterations의 sum - algorithm 지표. checkpoint로 줄지 않습니다" },

    { "offset": "0x034", "name": "EXECUTED_ITERATIONS", "access": "RO", "width": 32,
      "desc": "executed iterations - checkpoint가 줄이는 대상" },

    { "offset": "0x038", "name": "CYCLE_COUNT", "access": "RO", "width": 32,
      "desc": "run 소비 cycle. clk_accel(100 MHz) 기준이므로 µs = cycles/100" },

    { "offset": "0x03C", "name": "ENUM_CFG", "access": "RW", "width": 8,
      "desc": "enumeration mode 설정",
      "fields": [
        { "name": "enum_enable",       "bits": "0",   "desc": "0: Single, 1: Enumeration" },
        { "name": "fail_repeat_limit", "bits": "7:4", "desc": "complete-BBHT failure 연속 횟수 한계. 유효 1~15, 0 은 config error" }
      ] },

    { "offset": "0x040", "name": "FIFO_DATA", "access": "RPOP", "width": 14,
      "desc": "Result FIFO head. 읽기 완료 자체가 pop 입니다. 별도 POP register는 없습니다" },

    { "offset": "0x044", "name": "FIFO_COUNT", "access": "RO", "width": 9,
      "desc": "현재 FIFO occupancy" },

    { "offset": "0x048", "name": "FOUND_COUNT", "access": "RO", "width": 15,
      "desc": "unique solution 누적" },

    { "offset": "0x04C", "name": "CONSEC_FAIL", "access": "RO", "width": 4,
      "desc": "complete BBHT failure 연속 횟수" },

    { "offset": "0x050", "name": "MAX_FIFO_OCC", "access": "RO", "width": 9,
      "desc": "run 중 최대 occupancy" },

    { "offset": "0x054", "name": "FIFO_STALL", "access": "RO", "width": 32,
      "desc": "FIFO full 로 멈춘 cycle" },

    { "offset": "0x058", "name": "DATA_ADDR", "access": "RW", "width": 32,
      "desc": "System SRAM 원본 address. 4-byte 정렬 필수" },

    { "offset": "0x05C", "name": "DMA_COMMAND", "access": "W1P", "width": 1,
      "desc": "DMA load 시작",
      "fields": [ { "name": "dma_start", "bits": "0", "desc": "DMA session start" } ] },

    { "offset": "0x060", "name": "DMA_STATUS", "access": "RO", "width": 8,
      "desc": "DMA state. bit 정의는 dma_status_bits 참조" },

    { "offset": "0x064", "name": "POLICY_CYCLES_TOTAL",      "access": "RO", "width": 32, "desc": "policy 총 cycle",   "group": "telemetry" },
    { "offset": "0x068", "name": "POLICY_STALL_CYCLES",      "access": "RO", "width": 32, "desc": "policy stall",        "group": "telemetry" },
    { "offset": "0x06C", "name": "POLICY_ACTIONS_EVAL",      "access": "RO", "width": 32, "desc": "평가한 action 수",    "group": "telemetry" },
    { "offset": "0x070", "name": "POLICY_MEMO_HIT",          "access": "RO", "width": 32, "desc": "memo hit",            "group": "telemetry" },
    { "offset": "0x074", "name": "POLICY_MEMO_MISS",         "access": "RO", "width": 32, "desc": "memo miss",           "group": "telemetry" },
    { "offset": "0x078", "name": "POLICY_MAX_LATENCY",       "access": "RO", "width": 32, "desc": "policy 최대 latency",     "group": "telemetry" },
    { "offset": "0x07C", "name": "PLAN_QUEUE_LEVEL",          "access": "RO", "width": 3,  "desc": "현재 Plan Queue 레벨",  "group": "telemetry" },
    { "offset": "0x080", "name": "PLAN_QUEUE_HIGHWATER",      "access": "RO", "width": 3,  "desc": "Plan Queue 최고 수위",  "group": "telemetry" },
    { "offset": "0x084", "name": "PLAN_QUEUE_EMPTY_DEMAND",   "access": "RO", "width": 32, "desc": "demand 시 empty 횟수", "group": "telemetry" },
    { "offset": "0x088", "name": "PLAN_QUEUE_HIT_COUNT",      "access": "RO", "width": 32, "desc": "speculative plan hit", "group": "telemetry" },
    { "offset": "0x08C", "name": "PLAN_QUEUE_MISS_COUNT", "access": "RO", "width": 32, "desc": "정상 기대값 0",        "group": "telemetry" },
    { "offset": "0x090", "name": "POLICY_COLD_SOLVE_COUNT",  "access": "RO", "width": 32, "desc": "cold solve 횟수",      "group": "telemetry" },
    { "offset": "0x094", "name": "POLICY_SPEC_SOLVE_COUNT",  "access": "RO", "width": 32, "desc": "speculative solve",    "group": "telemetry" }
  ],

  "status_bits": [
    { "bit": 0,  "name": "busy",              "desc": "search/main busy" },
    { "bit": 1,  "name": "load_busy",         "desc": "Main IP loader busy" },
    { "bit": 2,  "name": "done_sticky",       "desc": "search 완료 sticky. COMMAND 쓰기로 클리어" },
    { "bit": 3,  "name": "result_valid",      "desc": "Single result 유효" },
    { "bit": 4,  "name": "config_error",      "desc": "설정 오류 sticky" },
    { "bit": 5,  "name": "shot_limit",        "desc": "shot cap 도달 sticky" },
    { "bit": 6,  "name": "budget_limit",      "desc": "BBHT budget 도달 sticky" },
    { "bit": 7,  "name": "amp_overflow",      "desc": "amplitude saturation sticky. 진단용이며 종료 사유가 아님" },
    { "bit": 8,  "name": "zero_weight_error", "desc": "Born-rule sampling total weight 오류 sticky" },
    { "bit": 9,  "name": "load_error",        "desc": "DMA Engine 검사 오류 sticky" },
    { "bit": 10, "name": "enum_done",         "desc": "Enumeration 종료 sticky" },
    { "bit": 11, "name": "fifo_empty",        "desc": "Result FIFO 비어 있음" }
  ],

  "dma_status_bits": [
    { "bit": 0, "name": "dma_busy",        "desc": "DMA 진행 중" },
    { "bit": 1, "name": "dma_error",       "desc": "아래 오류들의 OR" },
    { "bit": 2, "name": "align_error",     "desc": "DATA_ADDR 4-byte 정렬 위반" },
    { "bit": 3, "name": "count_error",     "desc": "DATA_COUNT 범위 위반" },
    { "bit": 4, "name": "resp_error",      "desc": "AHB 응답 오류" },
    { "bit": 5, "name": "busy_error",      "desc": "Accelerator Core busy 라서 DMA 거절" },
    { "bit": 6, "name": "range_error",     "desc": "System SRAM 범위 밖" },
    { "bit": 7, "name": "dma_done_sticky", "desc": "DMA 완료 sticky" }
  ],

  "predicate_modes": [
    { "value": 0, "name": "LT",    "desc": "data < A" },
    { "value": 1, "name": "GT",    "desc": "data > A" },
    { "value": 2, "name": "EQ",    "desc": "data == A" },
    { "value": 3, "name": "RANGE", "desc": "A < data < B (열린구간)" }
  ],

  "run_modes": [
    { "name": "MANUAL_SINGLE",  "auto_shot": 0, "burst_enable": 0, "enum_enable": 0, "desc": "J_TARGET을 firmware가 지정" },
    { "name": "RESTART_SINGLE",  "auto_shot": 1, "burst_enable": 0, "enum_enable": 0, "desc": "Restart mode. 표준 BBHT" },
    { "name": "CHECKPOINT_SINGLE",    "auto_shot": 1, "burst_enable": 1, "enum_enable": 0, "desc": "Checkpoint mode (Checkpoint-Capacity · Lookahead-Shots · number of PEs · Measurement Microarchitecture는 RTL build에 컴파일됨. 현 Board-Verified Build는 final configuration)" },
    { "name": "RESTART_ENUMERATION",    "auto_shot": 1, "burst_enable": 0, "enum_enable": 1, "desc": "Restart mode enumeration" },
    { "name": "CHECKPOINT_ENUMERATION",      "auto_shot": 1, "burst_enable": 1, "enum_enable": 1, "desc": "Checkpoint mode enumeration (Checkpoint-Capacity · Lookahead-Shots · number of PEs · Measurement Microarchitecture는 RTL build에 컴파일됨. 현 Board-Verified Build는 final configuration)" }
  ]
}
