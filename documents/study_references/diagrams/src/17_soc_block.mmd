flowchart LR
    HOST["호스트 PC<br/>파이썬 스크립트<br/>ASCII 라인 명령"]

    subgraph SOC["RVX SoC (생성물)"]
        direction TB
        UARTIP["readymade UART<br/>115200 8N1"]
        CORE["rvc_orca<br/>RV32 코어"]
        NOC["munoc 인터커넥트"]
        SRAM["system SRAM<br/>0xe0000000"]
        UARTIP --- CORE
        CORE --- NOC
        NOC --- SRAM
    end

    subgraph IP["그로버 가속기 IP (직접 설계)"]
        direction TB
        CSR["APB 슬레이브<br/>CSR 블록"]
        CTRL["샷 루프 FSM<br/>+ 반복 FSM<br/>+ Born 샘플러"]
        DMA["AHB 마스터<br/>INCR16 버스트"]
        AMP[("amp_mem<br/>32뱅크 × 1024 × 18b")]
        DATA[("data_mem<br/>32뱅크 × 1024 × 16b")]
        MASK[("mask_mem<br/>1024 × 32b")]
        CSR --> CTRL
        CTRL --- AMP
        CTRL --- DATA
        CTRL --- MASK
        DMA --> DATA
    end

    HOST <-->|"UART"| UARTIP
    NOC <-->|"APB — 설정 · 상태"| CSR
    NOC <-->|"AHB — 배열 적재"| DMA
