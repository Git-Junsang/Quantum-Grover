graph LR
    subgraph MEM["메모리 (BRAM)"]
        AMP["amp_mem<br/>진폭"]
        VAL["data_mem<br/>탐색 데이터"]
    end
    ORA["오라클<br/>비교 + 부호 반전"]
    SUM["합산 · 평균"]
    DIF["확산<br/>2·평균 − 진폭"]
    MEA["측정<br/>Born 샘플링"]
    VER["검증"]
    FSM["ctrl_fsm"]

    VAL --> ORA
    AMP --> ORA
    ORA --> AMP
    ORA --> SUM --> DIF
    AMP --> DIF
    DIF --> AMP
    AMP --> MEA --> VER
    VAL --> VER
    FSM -.-> ORA
    FSM -.-> DIF
    FSM -.-> MEA
